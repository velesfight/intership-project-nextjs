{
  "name": "nude_web_v2_next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "api:generate": "npx swagger-typescript-api generate --path https://dev-back-nude-sdhf43sd5f-v2.ghfls.ru/docs-yaml --output src/shared/api/artifacts --name generated.ts --responses --sort-types --sort-routes --axios --unwrap-response-data",
    "build": "next build --turbopack",
    "build-storybook": "storybook build",
    "dev": "next dev --turbopack --port 5200",
    "format": "prettier --list-different .",
    "format:fix": "prettier --list-different --write .",
    "lint": "next lint",
    "lint:fix": "npm run lint -- --fix",
    "optimize:svg": "svgo src/shared/assets --recursive",
    "prepare": "husky",
    "start": "next start --port 5200",
    "storybook": "storybook dev -p 5201",
    "stylelint": "stylelint \"src/**/*.css\" --allow-empty-input",
    "stylelint:fix": "npm run stylelint -- --fix strict",
    "typecheck": "tsc"
  },
  "browserslist": [
    "Chrome >= 109",
    "Edge >= 109",
    "Safari >= 15.6",
    "Firefox >= 115",
    "ChromeAndroid >= 109",
    "iOS >= 15.6"
  ],
  "dependencies": {
    "clsx": "^2.1.1",
    "deepmerge": "^4.3.1",
    "next": "15.5.5",
    "next-intl": "^4.3.12",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@csstools/postcss-global-data": "^3.1.0",
    "@storybook/nextjs": "^9.1.13",
    "@svgr/webpack": "^8.1.0",
    "@types/node": "^20.19.21",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "eslint": "^9.37.0",
    "eslint-config-next": "^15.5.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-perfectionist": "^4.15.1",
    "eslint-plugin-storybook": "^9.1.13",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.4",
    "postcss-preset-env": "^10.4.0",
    "prettier": "^3.6.2",
    "prettier-plugin-packagejson": "^2.5.19",
    "storybook": "^9.1.13",
    "stylelint": "^16.25.0",
    "stylelint-config-standard": "^39.0.1",
    "stylelint-use-logical-spec": "^5.0.1",
    "svgo": "^4.0.0",
    "swagger-typescript-api": "^13.2.15",
    "typescript": "^5.8.3",
    "typescript-plugin-css-modules": "^5.2.0",
    "validate-branch-name": "^1.3.2"
  }
